# Caddy — QA entry point (T3.3). Automatic HTTPS (Let's Encrypt, HTTP-01) for {$SITE_DOMAIN}.
# The only service that publishes ports (80/443). Security headers come from the API;
# Caddy adds HSTS and removes its own Server header.
{
	admin off
	# No access log here: the API already logs every request (with redaction).
	servers {
		protocols h1 h2 h3
		timeouts {
			read_header 10s
			read_body 30s
			write 60s
			idle 2m
		}
	}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		# 1 year, no includeSubDomains/preload: the domain is a shared free DNS zone (DuckDNS).
		Strict-Transport-Security "max-age=31536000"
		-Server
		-Via
	}

	request_body {
		max_size 2MB
	}

	reverse_proxy api:8080 {
		# Caddy sets X-Forwarded-For to the real client (ignoring client-supplied values,
		# no trusted_proxies configured here); the API trusts it only from this container.
		header_down -Server
		# Single upstream: retry while the API restarts (deployments) instead of failing fast.
		lb_try_duration 10s
		lb_try_interval 250ms
	}
}

# --- Web portals of the frontend (booking-platform-frontend, ADR-F003/F006) ----------------
# Each portal has its own host; /api/* on that same origin goes to the API, so the browser only
# talks to one origin and the HttpOnly session cookie stays per portal. The portals run in their
# own Compose projects (qa/web/docker-compose.yml) on this network; until one is deployed its
# host answers 502 without affecting the API site above.
(portal) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
		-Via
	}

	request_body {
		max_size 2MB
	}

	handle /api/* {
		reverse_proxy api:8080 {
			header_down -Server
			lb_try_duration 10s
			lb_try_interval 250ms
		}
	}

	handle {
		reverse_proxy {args[0]}:3000 {
			header_down -Server
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}

{$APP_DOMAIN} {
	import portal business-web
}

{$ADMIN_DOMAIN} {
	import portal admin-web
}
