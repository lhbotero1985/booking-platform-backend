# Daily PostgreSQL backup of the QA stack (T3.6). Installed in /etc/systemd/system/.
[Unit]
Description=booking-platform PostgreSQL backup
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
ExecStart=/usr/local/bin/booking-backup daily
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/booking/qa
TimeoutStartSec=30min
