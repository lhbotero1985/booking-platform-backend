# Copiar a .env (ignorado por Git) y ajustar. SOLO para DEV local con datos sintéticos.
# En QA/PROD los valores vienen de GitHub Environments y del servidor, nunca de este archivo.

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080
# Orígenes exactos separados por coma (sin comodines). Ej: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Opcionales (valores por defecto mostrados)
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=120s
# HTTP_SHUTDOWN_TIMEOUT=20s
# HTTP_MAX_BODY_BYTES=1048576

# --- Base de datos ---
# Para ejecutar la API fuera de Docker (go run ./cmd/api) contra el PostGIS del compose.
# Dentro de Docker Compose la URL se arma en docker-compose.dev.yml.
DATABASE_URL=postgres://booking:change-me-local-only@127.0.0.1:55432/booking_dev?sslmode=disable
# Opcional: rol con permisos DDL para "api migrate" (por defecto usa DATABASE_URL)
# DATABASE_MIGRATOR_URL=
# DB_MAX_CONNS=10
# DB_CONNECT_TIMEOUT=5s

# --- Contraseñas (Argon2id, ADR-0006) ---
# Calibrar en el servidor destino: objetivo ≈100–250 ms por hash.
# ARGON2_MEMORY_KIB=65536
# ARGON2_ITERATIONS=3
# ARGON2_PARALLELISM=2
# ARGON2_MAX_CONCURRENT=4

# --- Proxy inverso: IPs/CIDR de los proxies cuyo X-Forwarded-For se cree (vacío en DEV) ---
# TRUSTED_PROXIES=

# --- Rate limiting y backoff de login (en memoria; por IPv4 o prefijo IPv6 /64) ---
# RATE_LIMIT_API_PER_MINUTE=300
# RATE_LIMIT_API_BURST=100
# RATE_LIMIT_AUTH_PER_MINUTE=10
# RATE_LIMIT_AUTH_BURST=10
# RATE_LIMIT_MAX_KEYS=100000
# LOGIN_BACKOFF_THRESHOLD=5
# LOGIN_BACKOFF_MAX=15m

# --- Email (SMTP) y enlaces ---
# DEV y QA usan Mailpit (UI DEV: http://127.0.0.1:8025; en QA solo por túnel SSH).
# PROD: SMTP del proveedor con SMTP_TLS=starttls|tls (obligatorio).
PUBLIC_APP_URL=http://localhost:3000
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=Booka <no-reply@booking.local>
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=none
MAILPIT_UI_PORT=8025

# --- Notificaciones (T7.1) ---
# WhatsApp apagado por defecto en DEV: los mensajes quedan SKIPPED (CHANNEL_DISABLED).
# Encendido y sin credenciales de Meta, se usa el envío simulado (solo un log, número enmascarado).
# WHATSAPP_ALLOWLIST: si se define, solo esos números (E.164, separados por coma) reciben mensajes.
# WHATSAPP_ENABLED=false
# WHATSAPP_ALLOWLIST=
# Topes de WhatsApp (T7.9, lo paga la plataforma): mensajes por negocio al mes si el administrador
# no le fijó uno propio (0 = sin tope por defecto) y de toda la plataforma al día (0 = sin tope).
# WHATSAPP_MONTHLY_LIMIT=500
# WHATSAPP_DAILY_LIMIT=0
# WhatsApp Cloud API de Meta (T7.2). Sin token se usa el envío simulado. Con token, fuera de
# producción WHATSAPP_ALLOWLIST es obligatorio. Nunca poner un token real en este archivo ni en Git:
# en QA va en /opt/booking/qa/.env del servidor.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_BASE_URL=https://graph.facebook.com
# WHATSAPP_GRAPH_VERSION=v23.0
# Enlaces de los correos de citas (T7.7): origen público de esta API y, opcional, la página del
# frontend para elegir la nueva hora (recibe ?token=).
# PUBLIC_API_URL=http://localhost:8080
# APPOINTMENT_RESCHEDULE_URL=
# Página del frontend para calificar una cita atendida (recibe ?appointmentId=; 2026-11-28).
# Vacía: el correo invita a calificar desde «Mis citas» de la app.
# APPOINTMENT_REVIEW_URL=
# Correos de citas (T7.6): activos por defecto; van por el mismo SMTP (Mailpit en DEV/QA).
# NOTIFICATIONS_EMAIL_ENABLED=true
# Webhook (T7.5): clave secreta de la app de Meta y token de verificación (los dos o ninguno).
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Enlace de descarga de la app (GET /app, botón de la plantilla cita_agendada_negocio). Vacío: página
# "la app estará disponible muy pronto".
# APP_DOWNLOAD_URL=

# Negocios que una cuenta puede crear por sí misma (P-11): 2 durante la demo; los planes de la
# fase 11B lo ajustarán.
# OWNED_BUSINESS_LIMIT=2

# Imágenes de negocios y profesionales (logo, portada, portafolio): directorio del disco del
# servidor. En Docker es el volumen "media" montado en /data/media.
# MEDIA_DIR=./data/media

# --- Worker (River) ---
# WORKER_SHUTDOWN_TIMEOUT=30s

# --- Docker Compose DEV ---
API_PORT=8080
POSTGRES_PORT=55432
POSTGRES_DB=booking_dev
POSTGRES_USER=booking
# Cambiar por un valor local cualquiera; no reutilizar contraseñas reales.
POSTGRES_PASSWORD=change-me-local-only
