# Copiar a .env (ignorado por Git) y ajustar. SOLO para DEV local con datos sintéticos.
# En QA/PROD los valores vienen de GitHub Environments y del servidor, nunca de este archivo.

# --- Aplicación ---
APP_ENV=development
LOG_LEVEL=debug
HTTP_ADDR=:8080
# Orígenes exactos separados por coma (sin comodines). Ej: http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Opcionales (valores por defecto mostrados)
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=15s
# HTTP_WRITE_TIMEOUT=30s
# HTTP_IDLE_TIMEOUT=120s
# HTTP_SHUTDOWN_TIMEOUT=20s
# HTTP_MAX_BODY_BYTES=1048576

# --- Base de datos ---
# Para ejecutar la API fuera de Docker (go run ./cmd/api) contra el PostGIS del compose.
# Dentro de Docker Compose la URL se arma en docker-compose.dev.yml.
DATABASE_URL=postgres://booking:change-me-local-only@127.0.0.1:55432/booking_dev?sslmode=disable
# Opcional: rol con permisos DDL para "api migrate" (por defecto usa DATABASE_URL)
# DATABASE_MIGRATOR_URL=
# DB_MAX_CONNS=10
# DB_CONNECT_TIMEOUT=5s

# --- Contraseñas (Argon2id, ADR-0006) ---
# Calibrar en el servidor destino: objetivo ≈100–250 ms por hash.
# ARGON2_MEMORY_KIB=65536
# ARGON2_ITERATIONS=3
# ARGON2_PARALLELISM=2
# ARGON2_MAX_CONCURRENT=4

# --- Email (SMTP) y enlaces ---
# DEV y QA usan Mailpit (UI DEV: http://127.0.0.1:8025; en QA solo por túnel SSH).
# PROD: SMTP del proveedor con SMTP_TLS=starttls|tls (obligatorio).
PUBLIC_APP_URL=http://localhost:3000
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=Reservas <no-reply@booking.local>
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=none
MAILPIT_UI_PORT=8025

# --- Worker (River) ---
# WORKER_SHUTDOWN_TIMEOUT=30s

# --- Docker Compose DEV ---
API_PORT=8080
POSTGRES_PORT=55432
POSTGRES_DB=booking_dev
POSTGRES_USER=booking
# Cambiar por un valor local cualquiera; no reutilizar contraseñas reales.
POSTGRES_PASSWORD=change-me-local-only
