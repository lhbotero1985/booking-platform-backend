        {
          "name": "DISPONIBILIDAD del barbero el día targetDate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/businesses/{{slug}}/availability?serviceId={{serviceId}}&professionalId={{professionalId}}&date={{targetDate}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "businesses",
                "{{slug}}",
                "availability"
              ],
              "query": [
                {
                  "key": "serviceId",
                  "value": "{{serviceId}}"
                },
                {
                  "key": "professionalId",
                  "value": "{{professionalId}}"
                },
                {
                  "key": "date",
                  "value": "{{targetDate}}"
                }
              ]
            },
            "description": "Con la política por defecto (cada 10 min, 60 min de antelación, sin preparación) y un servicio de 30 min se esperan 09:00–12:30, 14:00–14:30 y 16:00–17:30.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const hhmm = s => s.startLocal.slice(11, 16);",
                  "const mins = t => +t.slice(0, 2) * 60 + +t.slice(3, 5);",
                  "const times = b.slots.map(hhmm);",
                  "if (b.slots.length) pm.collectionVariables.set('firstSlot', b.slots[0].startAt);",
                  "console.log('Horas libres el', b.date, '(' + b.timeZone + ', ' + b.durationMinutes + ' min):', times.join(' '));",
                  "pm.test('hay horas libres', () => pm.expect(times.length).to.be.above(0));",
                  "pm.test('todas dentro del horario 09:00-18:00', () => times.forEach(t => pm.expect(mins(t) >= 540 && mins(t) + b.durationMinutes <= 1080, t).to.be.true));",
                  "pm.test('ninguna cruza el descanso 13:00-14:00', () => times.forEach(t => pm.expect(mins(t) + b.durationMinutes <= 780 || mins(t) >= 840, t).to.be.true));",
                  "pm.test('ninguna cruza la ausencia 15:00-16:00', () => times.forEach(t => pm.expect(mins(t) + b.durationMinutes <= 900 || mins(t) >= 960, t).to.be.true));",
                  "pm.test('sin datos internos', () => pm.expect(Object.keys(b).sort()).to.eql(['date', 'durationMinutes', 'professionalId', 'serviceId', 'slots', 'timeZone']));",
                  "pm.test('cada hora trae UTC y hora local', () => b.slots.forEach(s => pm.expect(Object.keys(s).sort()).to.eql(['endAt', 'startAt', 'startLocal'])));"
                ]
              }
            }
          ]
        },
