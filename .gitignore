# Monorepo booking-platform. Las reglas aplican a todos los proyectos.

# --- Secretos y configuración local (NUNCA versionar) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets/
*.age
!*.age.example

# --- Go (backend) ---
booking-platform-backend/bin/
booking-platform-backend/dist/
booking-platform-backend/vendor/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage.*
go.work
go.work.sum

# --- Node / Next.js / Expo (frontend) ---
node_modules/
.next/
out/
.expo/
.expo-shared/
web-build/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
.turbo/

# --- Infraestructura ---
*.tfstate
*.tfstate.*
.terraform/

# --- Herramientas ---
.task/
tmp/

# --- Datos locales / volúmenes / backups ---
data/
*.dump
*.sql.gz
backups/

# --- IDE / SO ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
.DS_Store
Thumbs.db

# --- Claude Code: configuración local personal ---
.claude/settings.local.json
